```{r extract and merge randomisation file PER PARTICIPANT}
# ----------------------------
# FIND RANDOMISATION INFORMATION
# ----------------------------
results_files <- list.files(
pattern = "^jatos_results_.*",
full.names = TRUE
) %>%
purrr::map(~ list.files(.x,
pattern = "data\\.txt$",
recursive = TRUE,
full.names = TRUE)) %>%
unlist()
index_file <- results_files[8]
jatos_raw <- readLines(index_file, warn = FALSE)
jatos_json <- fromJSON(paste(jatos_raw, collapse = ""))
selected_files <- unique(unlist(jatos_json$selected_randomisation))
# ----------------------------
# 1. STUDY DATA
# ----------------------------
# get the study_result_... files
study_files <- list.files(
here("demo_results", "participant_exports"),
pattern = "^study_result_.*\\.csv$",
full.names = TRUE
)
#merge study results from all participants
all_data <- purrr::map_dfr(study_files, function(file) {
read.csv(file) %>%
mutate(
sentence_id = stringr::str_extract(file_name, "\\d+"),
study_file = basename(file)
)
})
# ----------------------------
# 3. EXTRACT TRUE RANDOMISATION FILES
# ----------------------------
stim_files <- selected_files
lookup <- purrr::map_dfr(stim_files, function(file) {
temp <- read.csv(file, stringsAsFactors = FALSE,
check.names = FALSE)
names(temp) <- trimws(names(temp))
# find sentence column
col_name <- names(temp) [stringr::str_detect(names(temp), "Sentence")][1]
temp %>%
transmute(
sentence_id =
stringr::str_remove(as.character(.data[[col_name]]),
"^_"),
randomisation =
tools::file_path_sans_ext(basename(file)),
Answer = Answer,
Sentence = Sentence
) %>%
distinct()
})
# ----------------------------
# 5. FINAL MERGE
# ----------------------------
final_data <- all_data %>%
left_join(lookup, by = "sentence_id") %>%
relocate(Sentence, Answer, .before = mic_input_text) %>%
group_by(randomisation) %>%
mutate(randomisation_sentence_index = row_number()) %>%
ungroup() %>%
relocate(randomisation_sentence_index, .after = sentence_index)
# correct data only for first participant
first_participant <- unique(final_data$study_file)[1]
