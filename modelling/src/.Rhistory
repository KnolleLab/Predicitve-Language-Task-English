library(jsonlite)
library(dplyr)
library(stringr)
library(readr)
library(purrr)
library(here)
# ----------------------------
# FIND RANDOMISATION INFORMATION
# ----------------------------
results_files <- list.files(
pattern = "^jatos_results_.*",
full.names = TRUE
) %>%
purrr::map(~ list.files(.x,
pattern = "data\\.txt$",
recursive = TRUE,
full.names = TRUE)) %>%
unlist()
jatos_raw <- readLines(index_file, warn = FALSE)
jatos_json <- fromJSON(paste(jatos_raw, collapse = ""))
selected_files <- unique(unlist(jatos_json$selected_randomisation))
# ----------------------------
# 1. STUDY DATA
# ----------------------------
# get the study_result_... files
study_files <- list.files(
here("demo_results", "participant_exports"),
pattern = "^study_result_.*\\.csv$",
full.names = TRUE
)
#merge study results from all participants
all_data <- purrr::map_dfr(study_files, function(file) {
read.csv(file) %>%
mutate(
sentence_id = stringr::str_extract(file_name, "\\d+"),
study_file = basename(file)
)
})
# ----------------------------
# 3. EXTRACT TRUE RANDOMISATION FILES
# ----------------------------
stim_files <- selected_files
lookup <- purrr::map_dfr(stim_files, function(file) {
temp <- read.csv(file, stringsAsFactors = FALSE,
check.names = FALSE)
names(temp) <- trimws(names(temp))
# find sentence column
col_name <- names(temp) [stringr::str_detect(names(temp), "Sentence")][1]
temp %>%
transmute(
sentence_id =
stringr::str_remove(as.character(.data[[col_name]]),
"^_"),
randomisation =
tools::file_path_sans_ext(basename(file)),
Answer = Answer,
Sentence = Sentence
) %>%
distinct()
})
# correct data only for first participant
first_participant <- unique(final_data$study_file)[1]
final_data$randomisation[final_data$study_file != first_participant] <- NA
# sample strings
final_data$mic_input_text<- tolower(final_data$mic_input_text)
string_vec1<- final_data$Answer
string_vec2<- final_data$mic_input_text
# calculate Levenshtein Distance
final_data$levenshtein<- stringdist(string_vec1, string_vec2, method = 'lv')
final_data$damerau_levenshtein<- stringdist(string_vec1, string_vec2, method = 'dl') # almost no difference to lv
final_data$longest_common_string<- stringdist(string_vec1, string_vec2, method = 'lcs')
final_data$jaro_winkler<- stringdist(string_vec1, string_vec2, method='jw', p=0.1)
final_data$jaro_correct <- final_data$jaro_winkler <= 0.2
final_data$soundex<- stringdist(string_vec1, string_vec2, method = 'soundex')
final_data <- final_data %>%
relocate(
levenshtein,
optimal_string_alignment,
damerau_levenshtein,
longest_common_string,
jaro_winkler,
soundex,
.after = mic_input_text
)
final_data <- final_data %>%
relocate(
levenshtein,
optimal_string_alignment,
damerau_levenshtein,
longest_common_string,
jaro_winkler,
soundex,
.after = mic_input_text
)
